#!/bin/sh
# run -- run a pipeline file: every stage, some stages, or a range of them.
# Copyright 2026 Corwin Brust; GPL-3.0-or-later
#
#   sh run                      every stage of pilot.pipeline, for every take it names
#   sh run narrate              one stage
#   sh run captions mp3         those stages, in pipeline order
#   sh run frames..burn         a range, first to last
#   sh run -t A                 only take A (overrides the pipeline's "set takes=")
#   sh run -p audio.pipeline    another pipeline file
#   sh run -l                   list the stages and settings
#   sh run -n                   say what would run, run nothing
#
# A pipeline file has one line per stage:   NAME  once|each  TOOL [ARGS...]  # note
# and settings:                              set NAME=VALUE
# Every setting reaches each tool as GW_NAME (an environment variable already
# set wins). "each" stages run once per take; "once" stages run on the first
# take's pass only. Tools ending .py run with python3, .sh with sh, .js with node.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
cd "$HERE"
PIPE=pilot.pipeline
ONLY_TAKES=""
LIST=""
DRY=""
while [ $# -gt 0 ]; do
  case $1 in
    -p) PIPE=$2; shift 2 ;;
    -t) ONLY_TAKES=$2; shift 2 ;;
    -l) LIST=1; shift ;;
    -n) DRY=1; shift ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    --) shift; break ;;
    -*) echo "run: unknown option $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
[ -f "$PIPE" ] || { echo "run: no pipeline file $PIPE" >&2; exit 2; }
ARGS=$*

: "${GW_SRC:=src}" "${GW_BUILD:=build}" "${GW_OUT:=.}" "${GW_CACHE:=${HOME:-.}/.cache/ghostwheel-pilot}"
# Every path absolute, so a stage never depends on the shell's working folder
# (a long run can outlive the folder handle it started in, as a synced mount can).
abs() { case $1 in /*) printf '%s' "$1" ;; *) mkdir -p "$1" && (cd "$1" && pwd) ;; esac; }
GW_SRC=$(abs "$GW_SRC"); GW_BUILD=$(abs "$GW_BUILD"); GW_OUT=$(abs "$GW_OUT"); GW_CACHE=$(abs "$GW_CACHE")
export GW_SRC GW_BUILD GW_OUT GW_CACHE

# settings: "set name=value" -> GW_NAME=value, unless already in the environment
STAGES=""
TAKES=""
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%%#*}
  set -f; set -- $line; set +f
  [ $# -eq 0 ] && continue
  if [ "$1" = set ]; then
    shift
    kv="$*"; k=${kv%%=*}; v=${kv#*=}
    if [ "$k" = takes ]; then TAKES=$v; continue; fi
    var=GW_$(printf '%s' "$k" | tr '[:lower:]-' '[:upper:]_')
    eval "cur=\${$var-}"
    if [ -z "$cur" ]; then eval "$var=\$v"; export "$var"; fi
    continue
  fi
  case $2 in once|each) ;; *) echo "run: $PIPE: stage '$1' must say once or each" >&2; exit 2 ;; esac
  STAGES="$STAGES $1"
done < "$PIPE"
[ -n "$ONLY_TAKES" ] && TAKES=$ONLY_TAKES
[ -n "$TAKES" ] || TAKES="-"

stage_line() {  # print the pipeline line for stage $1
  while IFS= read -r l || [ -n "$l" ]; do
    l=${l%%#*}; set -f; set -- $l; set +f
    [ $# -ge 3 ] && [ "$1" = "$want" ] && { printf '%s\n' "$l"; return 0; }
  done < "$PIPE"
  return 1
}

# which stages to run
PICK=""
if [ -z "$ARGS" ]; then
  PICK=$STAGES
else
  for a in $ARGS; do
    case $a in
      *..*)
        from=${a%%..*}; to=${a#*..}; on=""
        for s in $STAGES; do
          [ "$s" = "$from" ] && on=1
          [ -n "$on" ] && PICK="$PICK $s"
          [ "$s" = "$to" ] && on=""
        done ;;
      *)
        case " $STAGES " in *" $a "*) PICK="$PICK $a" ;; *) echo "run: no stage '$a' in $PIPE (have:$STAGES)" >&2; exit 2 ;; esac ;;
    esac
  done
  # keep pipeline order
  ordered=""
  for s in $STAGES; do case " $PICK " in *" $s "*) ordered="$ordered $s" ;; esac; done
  PICK=$ordered
fi

if [ -n "$LIST" ]; then
  echo "pipeline: $PIPE"
  echo "takes: $TAKES"
  env | grep '^GW_' | sort | sed 's/^/setting: /'
  for want in $STAGES; do printf 'stage: %s\n' "$(stage_line)"; done
  exit 0
fi

first=1
for take in $TAKES; do
  [ "$take" = "-" ] && take=""
  GW_TAKE=$take; export GW_TAKE
  for want in $PICK; do
    set -f; set -- $(stage_line); set +f
    name=$1 when=$2 tool=$3; shift 3
    if [ "$when" = once ] && [ -z "$first" ]; then continue; fi
    cd "$HERE"   # re-enter by name before every stage
    case $tool in
      *.py) cmd="python3 -B $HERE/$tool" ;;   # -B: no __pycache__ left in tools/
      *.sh) cmd="sh $HERE/$tool" ;;
      *.js) cmd="node $HERE/$tool" ;;
      *) cmd="$HERE/$tool" ;;
    esac
    printf '== %s (%s%s) ==\n' "$name" "$when" "${take:+, take $take}"
    if [ -n "$DRY" ]; then echo "   $cmd $*"; continue; fi
    t0=$(date +%s)
    $cmd "$@" || { echo "run: stage '$name' failed${take:+ for take $take}" >&2; exit 1; }
    echo "   ($(( $(date +%s) - t0 )) s)"
  done
  first=""
done
