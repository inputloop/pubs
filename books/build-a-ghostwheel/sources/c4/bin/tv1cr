#!/bin/sh
# tv1cr -- TSV one CxR: a table unfolded so a COLUMN is a COLLECTION (c/) and a ROW is a
#          REGISTRY (r/), folded back to the same bytes, set at a call grain, checked both ways.
#
# Copyright (C) 2026 Corwin Brust <corwin@bru.st> and Contributors.  Mentat (for Corwin).
# SPDX-License-Identifier: GPL-3.0-or-later
#
#   MUST     unfold: every cell (k,c,v) lands as r/<k>/<c> (content v) and c/<c>/<v> (a line k);
#            a duplicate key, a ragged row, a blank or comment line inside the table (between the
#            header and the first row too: found 2026-10-20 on pmo's epmo-keys.tsv, where fold hoisted
#            it and check still held, because check compares r with c, never with the table), or a stem
#            already holding r/ (without --replace) is refused and named.
#            fold: prints the table from a, l, t, n and r/ alone; writes nothing under the stem.
#            set: writes BOTH sides (the two writers) and keeps the trampled value under d/; it also writes
#            sc/<col> and sr/<key>, one line each, the stamp it used for d/<stamp>/ (the time the writer wrote down;
#            the cell's own mtime is the file system's, and a good made from this table is current only when the two agree).
#            unfold writes sc/ and sr/ for every column and key, with its own stamp.  fold ignores them.
#            check: every r atom is listed in its c twin and every c line reads back; exit 1 on
#            the first fault class found, every fault named by path.
#            check also reads the stamps: an sc/<name> that names no column of l, an sr/<name> that names no key of a, or a
#            stamp that is not a stamp, is a fault named by path.  A stamp newer than s is SAID (a "stale:" line), not a fault:
#            exit 1 stays for the fault classes only.  A stem made before today has no sc/ or sr/: that is not a fault.
#            stale: exit 1 when any atom is newer than the TSV, naming the newest, or when any sc/sr stamp is newer than s.
#            stale --col COL / --key KEY: exit 1 when that column's or key's stamp is newer than s, naming it (exit 2 when it
#            has no stamp or s holds none: the question cannot be answered, and that is said).
#            stamp: writes the missing sc/ and sr/ of an OLD stem from the files' mtimes (the file system's time, not the
#            writer's; a stamp already written is kept, it is the writer's own).  Needs GNU find (-printf).
#   JOURNEY  the stem beside the table (PATH/NAME/ for PATH/NAME.tsv); the files i l t n a d sc sr;
#            the name encoding (bare [a-z0-9._-]; an upper-case run is ^run^; any other byte
#            %XX; empty is %; over 200 bytes ends %~sha16).  Mine; his to change.
#            Model: h/MODEL-2026-10-19-cxr-column-collection-row-registry.md.  Q607-Q611.
#
# usage: tv1cr unfold TSV [--key COL[,COL..]] [--cols a,b,c] [--out DIR] [--replace]
#        tv1cr fold DIR [--where COL=VALUE] [--to TSV]      > TSV   (--to writes it, and marks s)
#        tv1cr set DIR KEY COL VALUE
#        tv1cr get DIR KEY [COL]
#        tv1cr who DIR COL VALUE
#        tv1cr col DIR NAME
#        tv1cr route DIR COL --into ROOT [--as NAME]       the column built into ROOT/c/<NAME>/<value>: one
#                                                          line per row, the row atom's ADDRESS (<rel>/r/<key>),
#                                                          never the value; idempotent; ROOT is asserted, not found
#        tv1cr route --check DIR COL --into ROOT [--as NAME] every routed line reads back; faults by path
#        tv1cr check DIR [--each]                    one pass over every atom; --each is the first, per-atom
#                                                          way, kept as a second reader
#        tv1cr stale DIR [TSV] [--col COL] [--key KEY]   no flag: atoms and stamps against the TSV and s; a flag: that stamp against s
#        tv1cr stamp DIR                              sc/ and sr/ for a stem made before they existed, from the files' mtimes
#        tv1cr enc STRING [--rule pc1|aj1]          (pc1 when not said: the command has no stem)
#        tv1cr dec NAME                              an aj1 name back to its value; refuses a name aj1 would not write
#        tv1cr selftest | --prove-red
#   --cols   the column names when the TSV has no header row (then fold prints none).
#   --rule   pc1 or aj1, for a NEW stem (default aj1, or TV1CR_NEW_RULE); an existing stem keeps its own.
#   --held-anyway  unfold a table a .cxr-hold line holds (it is refused otherwise, and the reason said).
#   --key    the column(s) whose values name a row; a composite key is its parts joined by a tab
#            (in a, and as KEY to set/get) and by + in its r/ dir name (r/^lc^+h%2F...).
#   The stem's files:  i IDENTITY (the key column, or columns, one per line) · l LAYOUT (columns, in order) · t TEMPLATE (the
#   header line, verbatim, when there was one) · n NOTE (leading # lines, verbatim) · o OTHER (trailing
#   # lines after the last row, verbatim; a # line between rows is refused) · a ARRAY (the
#   keys, in row order) · e EXPRESSION (the rule a value is named by: aj1; absent means pc1) · s SEMAPHORE (touched by unfold and fold --to: the last time atoms and
#   table were known equal) · r/ REGISTRY · c/ COLLECTION · d/<stamp>/ what --replace and set trampled · sc/ STAMP per column
#   (sc/<enc col>, one line: the time a hand last wrote a cell of it) · sr/ STAMP per row (sr/<enc key>, the same for a row).
#   A stamp is YYYYMMDDtHHMMSSz in an aj1 stem and YYYY-MM-DDTHHMMSSZ in a pc1 one (the form of s and of d/<stamp>/), UTC.
#   (h/MODEL-2026-10-27-forms-stamps-root.md section 2.)
set -eu
LC_ALL=C; export LC_ALL
me=tv1cr
TAB=$(printf '\t')

# aj1 (h/MODEL-2026-10-23-names-0-9a-z.md): a name of 0-9a-z only, j the escape letter (his word,
# 2026-10-23 01:08: the escaped part of a name is its jargon; az1, the same rule with z, came first and
# is refused by name).  0-9, a-i and k-z as themselves; j as jj; the ten commonest other bytes in his
# names as j0..j9 (space - . : / , > _ ( )); an upper-case run as ju, its length in one character of
# 0-9a-z, then the run in lower case; any other byte jx and two hex digits; the empty value je; a
# Windows device name jd and the name; composite key parts joined by jk; past 200, cut back to 180 or
# fewer at the end of a whole code, then jh and 16 hex of the sha256.
# One awk text, put in front of every awk program that names a value, so there is one copy here.
AJ1='function aj1init(   i, c) { B36 = "0123456789abcdefghijklmnopqrstuvwxyz"
    for (i = 1; i < 256; i++) AJO[sprintf("%c", i)] = i
    AJC[" "] = "0"; AJC["-"] = "1"; AJC["."] = "2"; AJC[":"] = "3"; AJC["/"] = "4"
    AJC[","] = "5"; AJC[">"] = "6"; AJC["_"] = "7"; AJC["("] = "8"; AJC[")"] = "9"
    for (c in AJC) AJR[AJC[c]] = c
    AJI = 1 }
  function aj1(s,   n, out, i, j, ch) {
    if (!AJI) aj1init()
    n = length(s); if (n == 0) return "je"
    out = ""; i = 1
    while (i <= n) {
      ch = substr(s, i, 1)
      if (ch ~ /[A-Z]/) {
        j = i; while (j <= n && j - i < 35 && substr(s, j, 1) ~ /[A-Z]/) j++
        out = out "ju" substr(B36, j - i + 1, 1) tolower(substr(s, i, j - i)); i = j; continue }
      if (ch == "j") out = out "jj"
      else if (ch ~ /[a-ik-z0-9]/) out = out ch
      else if (ch in AJC) out = out "j" AJC[ch]
      else out = out sprintf("jx%02x", AJO[ch])
      i++ }
    if (out ~ /^(con|prn|aux|nul|com[0-9]|lpt[0-9])$/) out = "jd" out
    return out }
  function aj1cut(n, k,   i, c, step) {
    if (!AJI) aj1init()
    i = 1
    while (i <= length(n)) {
      if (substr(n, i, 1) != "j") step = 1
      else { c = substr(n, i + 1, 1)
        if (c == "u") step = 2 + index(B36, substr(n, i + 2, 1)); else if (c == "x") step = 4; else step = 2 }
      if (i - 1 + step > k) break
      i += step }
    return substr(n, 1, i - 1) }
  function aj1hex(h) { return (index("0123456789abcdef", substr(h, 1, 1)) - 1) * 16 + index("0123456789abcdef", substr(h, 2, 1)) - 1 }
  function aj1dec(n,   i, c, out, m, L, t, h) {
    if (!AJI) aj1init()
    AJERR = ""; out = ""; i = 1; L = length(n)
    if (n !~ /^[0-9a-z]+$/) { AJERR = "a byte outside 0-9a-z"; return "" }
    if (n == "je") return ""
    if (substr(n, 1, 2) == "jd") { out = substr(n, 3); if (out !~ /^(con|prn|aux|nul|com[0-9]|lpt[0-9])$/) AJERR = "jd before a name that is not a device name"; return out }
    while (i <= L) {
      c = substr(n, i, 1)
      if (c != "j") { out = out c; i++; continue }
      if (i == L) { AJERR = "a j at the end"; return "" }
      c = substr(n, i + 1, 1)
      if (c == "j") { out = out "j"; i += 2 }
      else if (c ~ /[0-9]/) { out = out AJR[c]; i += 2 }
      else if (c == "u") { m = index(B36, substr(n, i + 2, 1)) - 1; t = substr(n, i + 3, m)
        if (m < 1 || length(t) != m || t !~ /^[a-z]+$/) { AJERR = "an upper-case run cut short"; return "" }
        out = out toupper(t); i += 3 + m }
      else if (c == "x") { h = substr(n, i + 2, 2)
        if (h !~ /^[0-9a-f][0-9a-f]$/ || h == "00") { AJERR = "jx without two hex digits"; return "" }
        out = out sprintf("%c", aj1hex(h)); i += 4 }
      else if (c == "h") { AJERR = "a hashed name: the value lives in r/, not in the name"; return "" }
      else if (c == "k") { AJERR = "a composite key: read each part between jk"; return "" }
      else { AJERR = "no code j" c " in aj1"; return "" } }
    if (aj1(out) != n) AJERR = "a name aj1 would not write (for this value it writes " aj1(out) ")"
    return out }
'
AZ1_GONE="az1 is the same rule with z as its escape letter, renamed aj1 on 2026-10-23 (his word at 01:08) before any stem used it"
RULE=pc1          # the rule of the stem in hand: no e file means pc1; need_stem and unfold set it

die() { printf '%s: %s\n' "$me" "$*" >&2; exit "${2:-2}"; }
usage() { sed -n '/^# usage:/,/^set -eu/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

# enc STRING -> a filename.  One rule, reversible below 200 bytes (see JOURNEY above).
enc() {
  V="$1" R="$RULE" awk "$AJ1"'BEGIN {
    if (ENVIRON["R"] == "aj1") { print aj1(ENVIRON["V"]); exit }
    s = ENVIRON["V"]; n = length(s); out = ""; up = 0
    for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
    for (i = 1; i <= n; i++) {
      ch = substr(s, i, 1)
      if (ch ~ /[A-Z]/) { if (!up) { out = out "^"; up = 1 }; out = out tolower(ch); continue }
      if (up) { out = out "^"; up = 0 }
      if (ch ~ /[a-z0-9._-]/) out = out ch
      else out = out sprintf("%%%02X", ord[ch])
    }
    if (up) out = out "^"
    if (out == "." || out == "..") gsub(/\./, "%2E", out)   # a name of . or .. is a folder, never a value (2026-10-20)
    if (out ~ /\.$/) out = substr(out, 1, length(out) - 1) "%2E"   # Windows drops a trailing dot (2026-10-23)
    if (out ~ /^(con|prn|aux|nul|com[0-9]|lpt[0-9])(\.|$)/) out = sprintf("%%%02X", ord[substr(out, 1, 1)]) substr(out, 2)   # a Windows device name (2026-10-23)
    if (out == "") out = "%"
    print out
  }'
}
encl() {  # enc, with the 200-byte cap
  e=$(enc "$1")
  if [ ${#e} -gt 200 ]; then
    h=$(printf '%s' "$1" | sha256sum | cut -c1-16)
    if [ "$RULE" = aj1 ]; then e=$(N="$e" awk "$AJ1"'BEGIN { print aj1cut(ENVIRON["N"], 180) }')"jh$h"
    else e=$(printf '%s' "$e" | cut -c1-180)"%~$h"; fi
  fi
  printf '%s\n' "$e"
}

stamp() { if [ "$RULE" = aj1 ]; then date -u +%Y%m%dt%H%M%Sz; else date -u +%Y-%m-%dT%H%M%SZ; fi; }   # aj1: a d/ folder's name is 0-9a-z too
# kenc KEY -> the r/ dir name: a composite key (parts joined by a tab) encodes part by part, joined
# by + (never produced by enc itself, so the join is unambiguous)
kenc() {
  ko=""; krest=$1; kj=+; [ "$RULE" = aj1 ] && kj=jk
  while :; do
    case $krest in
      *"$TAB"*) kpart=${krest%%"$TAB"*}; krest=${krest#*"$TAB"} ;;
      *) kpart=$krest; krest="" ;;
    esac
    ke_=$(encl "$kpart"); if [ -z "$ko" ]; then ko=$ke_; else ko="$ko$kj$ke_"; fi
    [ -n "$krest" ] || break
  done
  printf '%s\n' "$ko"
}
# keycell DIR RD -> the row's key, read from its key-part cells (tab-joined)
keycell() {
  kk=""; kfirst=1
  while IFS= read -r kpart; do
    kv=$(cell "$2/$(encl "$kpart")")
    if [ $kfirst -eq 1 ]; then kk=$kv; kfirst=0; else kk="$kk$TAB$kv"; fi
  done < "$1/i"
  printf '%s' "$kk"
}
# held TSV -> prints the reason and returns 0 when a .cxr-hold line in the table's folder or any folder
# above it names the table (GLOB<TAB>REASON, the glob read against the path from that folder), as cx1op
# reads it; returns 1 otherwise (fold-up ENHANCE 2, 2026-10-20)
held() {
  hd=$(cd "$(dirname -- "$1")" && pwd); hf=$hd/$(basename -- "$1")
  while :; do
    if [ -f "$hd/.cxr-hold" ]; then
      hrel=${hf#"$hd"/}
      hr=$(while IFS="$TAB" read -r g why; do
             case $g in '#'*|'') continue;; esac
             # shellcheck disable=SC2254
             case $hrel in $g) printf '%s\n' "${why:-held}"; break;; esac
           done < "$hd/.cxr-hold")
      [ -n "$hr" ] && { printf '%s, %s/.cxr-hold\n' "$hr" "$hd"; return 0; }
    fi
    [ "$hd" = / ] && return 1
    hd=$(dirname -- "$hd")
  done
}
need_stem() { [ -d "$1/r" ] && [ -f "$1/l" ] && [ -f "$1/i" ] || die "no table at $1 (wants r/, l, i)"; rule_of "$1"; }
# rule_of DIR -> RULE: the stem's e (EXPRESSION) names how values become names; none means pc1.  A rule
# this tool does not know is refused, never guessed (h/MODEL-2026-10-23-names-0-9a-z.md)
rule_of() {
  if [ -f "$1/e" ]; then RULE=$(head -1 "$1/e"); else RULE=pc1; fi
  case $RULE in pc1|aj1) ;; az1) die "$1/e names az1: $AZ1_GONE. Its names are written with z; unfold the stem again from its table (aj1 is the default for a new stem); not read" ;; *) die "$1/e names the rule '$RULE', which this tv1cr does not know (it reads pc1 and aj1); not read" ;; esac
}
colnum() {  # colnum DIR COL -> 1-based index in l, or empty
  awk -v c="$2" '$0 == c { print NR; exit }' "$1/l"
}
# read a cell: the file's bytes less one trailing newline; a missing file is empty
cell() { [ -f "$1" ] && awk 'NR > 1 { printf "\n" } { printf "%s", $0 }' "$1" || true; }
# stamp_re -> the regular expression a stamp of the stem in hand matches (the form of stamp(), by RULE)
stamp_re() {
  if [ "$RULE" = aj1 ]; then echo '^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]t[0-9][0-9][0-9][0-9][0-9][0-9]z$'
  else echo '^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z$'; fi
}
# first_line FILE -> its first line (empty when there is none)
first_line() { v=""; if [ -f "$1" ]; then IFS= read -r v < "$1" || true; fi; printf '%s' "$v"; }
# is_stamp VALUE -> exit 0 when it is a stamp in the stem's form
is_stamp() { printf '%s\n' "$1" | awk -v re="$(stamp_re)" '$0 ~ re { ok = 1 } END { exit !ok }'; }
# newer A B -> exit 0 when stamp A is later than stamp B (both in the stem's form: a string comparison is a time comparison)
newer() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a > b) }'; }

# ---------------------------------------------------------------- unfold
unfold() {
  tsv=${1:?TSV}; shift
  key=""; cols=""; out=""; replace=0; held_anyway=0; rule=""
  while [ $# -gt 0 ]; do
    case $1 in
      --key) key=$2; shift 2 ;;
      --cols) cols=$2; shift 2 ;;
      --out) out=$2; shift 2 ;;
      --replace) replace=1; shift ;;
      --held-anyway) held_anyway=1; shift ;;
      --rule) rule=$2; shift 2 ;;
      *) die "unfold: unknown option $1" ;;
    esac
  done
  [ -f "$tsv" ] || die "no such table: $tsv"
  if [ $held_anyway -eq 0 ] && why=$(held "$tsv"); then
    die "unfold: $tsv is held ($why); a .cxr-hold line says this table stays a table. Say --held-anyway to unfold it all the same"; fi
  [ -n "$out" ] || out=$(printf '%s' "$tsv" | sed 's/\.tsv$//')
  [ "$out" != "$tsv" ] || die "unfold: $tsv does not end in .tsv; say --out DIR"
  case ${rule:-pc1} in pc1|aj1) ;; az1) die "unfold: --rule az1: $AZ1_GONE; say aj1" ;; *) die "unfold: no rule named '$rule' (pc1, aj1)" ;; esac
  # the rule: a stem that exists keeps its own (e, or pc1 without one); a new stem gets aj1, or what
  # --rule or TV1CR_NEW_RULE says.  Changing an existing stem's rule is a migration: his word, not here.
  if [ -d "$out" ]; then
    rule_of "$out"
    [ -z "$rule" ] || [ "$rule" = "$RULE" ] || die "unfold: $out already names its values by rule $RULE; changing a stem's rule is a migration, and that is Corwin's word (unfold into a new folder to compare)"
  else
    RULE=${rule:-${TV1CR_NEW_RULE:-aj1}}
    case $RULE in pc1|aj1) ;; az1) die "unfold: TV1CR_NEW_RULE=az1: $AZ1_GONE; say aj1" ;; *) die "unfold: TV1CR_NEW_RULE names no rule: $RULE (pc1, aj1)" ;; esac
  fi
  if [ -d "$out/r" ] || [ -d "$out/c" ]; then
    [ $replace -eq 1 ] || die "unfold: $out already holds a table; say --replace to archive it under d/"
    st=$(stamp); mkdir -p "$out/d/$st"
    for f in r c a l i t n o s sc sr; do [ -e "$out/$f" ] && mv "$out/$f" "$out/d/$st/$f"; done
    printf '%s: archived the prior table at %s/d/%s\n' "$me" "$out" "$st" >&2
  fi
  mkdir -p "$out"
  [ "$RULE" = pc1 ] || [ -f "$out/e" ] || printf '%s\n' "$RULE" > "$out/e"
  # pass 1: shape.  Leading '#' lines are the NOTE; the first other line is the header (unless
  # --cols); every later line is a row.  Refuse blank, comment, ragged, duplicate.
  shape=$(COLS="$cols" awk -F"$TAB" -v OFS="$TAB" '
    BEGIN { cols = ENVIRON["COLS"]; nc = 0; head = 0; rows = 0; if (cols != "") { nc = split(cols, L, ","); head = 1 } }
    !rows && /^#/ && hl { print "FAULT", "comment line between the header and the first row at line " NR " (fold would put it above the header)"; exit 1 }
    !rows && /^#/ { print "n", $0; next }
    !head && /^$/ { print "FAULT", "blank line before the header at line " NR; exit 1 }
    !head { head = 1; hl = 1; nc = NF; for (i = 1; i <= NF; i++) L[i] = $i; print "t", $0; next }
    { rows = 1 }
    /^$/ { print "FAULT", "blank line inside the table at line " NR; exit 1 }
    /^#/ { tail[++nt] = $0; next }           # a comment after the rows is the trailing note (o)
    nt { print "FAULT", "comment line inside the table at line " (NR - nt); exit 1 }
    NF != nc { print "FAULT", "ragged row at line " NR ": " NF " fields, header has " nc; exit 1 }
    { print "row", NR }
    END { if (!head) { print "FAULT", "no header and no --cols"; exit 1 }
          for (i = 1; i <= nc; i++) print "l", L[i]
          for (i = 1; i <= nt; i++) print "o", tail[i] }' "$tsv") || true
  f=$(printf '%s\n' "$shape" | awk -F"$TAB" '$1 == "FAULT" { print $2; exit }')
  [ -z "$f" ] || die "unfold: $f"
  # scratch lives outside the stem: the c4 mount can create and truncate but not rm
  w=$(mktemp -d); trap 'rm -rf "$w"' EXIT
  printf '%s\n' "$shape" | awk -F"$TAB" '$1 == "n" { sub(/^[^\t]*\t/, ""); print }' > "$w/n"
  [ -s "$w/n" ] && cp "$w/n" "$out/n"
  printf '%s\n' "$shape" | awk -F"$TAB" '$1 == "t" { sub(/^[^\t]*\t/, ""); print }' > "$w/t"
  [ -s "$w/t" ] && cp "$w/t" "$out/t"
  printf '%s\n' "$shape" | awk -F"$TAB" '$1 == "o" { sub(/^[^\t]*\t/, ""); print }' > "$w/o"
  [ -s "$w/o" ] && cp "$w/o" "$out/o"
  printf '%s\n' "$shape" | awk -F"$TAB" '$1 == "l" { sub(/^[^\t]*\t/, ""); print }' > "$out/l"
  nc=$(grep -c '' "$out/l")
  [ "$nc" -gt 0 ] || die "unfold: no columns"
  [ -n "$key" ] || key=$(head -1 "$out/l")
  : > "$w/i"; kn=""
  # split on commas only: a column name may hold a space (a headless table's first cell does; found
  # 2026-10-20 on c4-serve's ollama-known.tsv by t/tv1cr-corpus.rb)
  printf '%s\n' "$key" | tr ',' '\n' > "$w/kparts"
  while IFS= read -r part; do
    n=$(colnum "$out" "$part"); [ -n "$n" ] || die "unfold: --key $part is not a column of $tsv"
    printf '%s\n' "$part" >> "$w/i"; kn="$kn${kn:+,}$n"
  done < "$w/kparts"
  cp "$w/i" "$out/i"
  # column dirs, encoded names in l's order
  : > "$w/cenc"
  while IFS= read -r c; do encl "$c" >> "$w/cenc"; done < "$out/l"
  # pass 2: the rows.  awk emits one line per atom; sh makes dirs once, then awk writes.
  skip=$(grep -c '' "$out/n" 2>/dev/null || echo 0); [ -f "$out/t" ] && skip=$((skip + 1))
  : > "$out/a"
  awk -F"$TAB" -v OFS="$TAB" -v skip="$skip" -v kn="$kn" 'BEGIN { np = split(kn, P, ",") }
    NR > skip && !/^#/ { k = $P[1]; for (j = 2; j <= np; j++) k = k "\t" $P[j]; print k }' "$tsv" > "$w/keys"
  dup=$(sort "$w/keys" | uniq -d | head -1)
  [ -z "$dup" ] || die "unfold: duplicate key in column $key: $dup"
  # encoded keys, one per line, same order
  : > "$w/kenc"
  while IFS= read -r k; do kenc "$k" >> "$w/kenc"; done < "$w/keys"
  cp "$w/keys" "$out/a"
  mkdir -p "$out/r" "$out/c"
  while IFS= read -r e; do mkdir -p "$out/r/$e"; done < "$w/kenc"
  while IFS= read -r e; do mkdir -p "$out/c/$e"; done < "$w/cenc"
  # write the atoms: r/K/C <- v ; c/C/<enc v> <<- k.  Value names are encoded in awk by the
  # same rule (the sh enc above is the reference; the spec holds them equal).
  OUT="$out" W="$w" awk -F"$TAB" -v skip="$skip" -v RULE="$RULE" "$AJ1"'
    function enc(s,   n, out, up, i, ch) {
      n = length(s); out = ""; up = 0
      for (i = 1; i <= n; i++) {
        ch = substr(s, i, 1)
        if (ch ~ /[A-Z]/) { if (!up) { out = out "^"; up = 1 }; out = out tolower(ch); continue }
        if (up) { out = out "^"; up = 0 }
        if (ch ~ /[a-z0-9._-]/) out = out ch
        else out = out sprintf("%%%02X", ord[ch])
      }
      if (up) out = out "^"
      if (out == "." || out == "..") gsub(/\./, "%2E", out)   # a name of . or .. is a folder, never a value (2026-10-20)
      if (out ~ /\.$/) out = substr(out, 1, length(out) - 1) "%2E"   # Windows drops a trailing dot (2026-10-23)
      if (out ~ /^(con|prn|aux|nul|com[0-9]|lpt[0-9])(\.|$)/) out = sprintf("%%%02X", ord[substr(out, 1, 1)]) substr(out, 2)   # a Windows device name (2026-10-23)
    if (out == "") out = "%"
      return out
    }
    BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
            out = ENVIRON["OUT"]
            while ((getline l < (out "/l")) > 0) L[++nc] = l
            w = ENVIRON["W"]
            while ((getline e < (w "/cenc")) > 0) CE[++ne] = e
            while ((getline e < (w "/kenc")) > 0) KE[++nk] = e
            while ((getline e < (w "/keys")) > 0) KS[++ns] = e
            longq = w "/longq" }
    NR > skip && !/^#/ {
      r = NR - skip; k = KE[r]; ks = KS[r]; rd = out "/r/" k
      for (i = 1; i <= nc; i++) {
        f = rd "/" CE[i]
        if ($i == "") printf "" > f; else print $i > f
        close(f)
        ve = (RULE == "aj1") ? aj1($i) : enc($i)
        if (length(ve) > 200) { print CE[i] "\t" $i "\t" ks >> longq; close(longq); continue }
        m = out "/c/" CE[i] "/" ve
        print ks >> m; close(m)
      }
    }' "$tsv"
  # the long values (over 200 bytes encoded) take the sha-capped name from encl
  if [ -s "$w/longq" ]; then
    while IFS="$TAB" read -r ce v k; do printf '%s\n' "$k" >> "$out/c/$ce/$(encl "$v")"; done < "$w/longq"
  fi
  st=$(stamp)           # one time for s, sc/ and sr/: the stamps a reader compares with s
  mkdir -p "$out/sc" "$out/sr"
  ST="$st" OUT="$out" awk '{ f = ENVIRON["OUT"] "/sc/" $0; print ENVIRON["ST"] > f; close(f) }' "$w/cenc"   # sc/<enc col>: when each column was last written
  ST="$st" OUT="$out" awk '{ f = ENVIRON["OUT"] "/sr/" $0; print ENVIRON["ST"] > f; close(f) }' "$w/kenc"   # sr/<enc key>: when each row was
  printf '%s\n' "$st" > "$out/s"      # written, not touched: touch rounds to the second on some mounts
  printf '%s: unfolded %s -> %s (%s key(s), %s column(s); key: %s)\n' "$me" "$tsv" "$out" \
    "$(grep -c '' "$out/a")" "$nc" "$key" >&2
}

# ---------------------------------------------------------------- fold
fold() {
  dir=${1:?DIR}; shift; where=""; to=""
  while [ $# -gt 0 ]; do case $1 in --where) where=$2; shift 2 ;; --to) to=$2; shift 2 ;; *) die "fold: unknown option $1" ;; esac; done
  need_stem "$dir"
  if [ -n "$to" ]; then
    [ -z "$where" ] || die "fold: --to writes the whole table; --where is a view"
    fold_ "$dir" > "$to.fold.tmp" && mv -f "$to.fold.tmp" "$to" && stamp > "$dir/s"
    printf '%s: folded %s -> %s (%s line(s)); s marked\n' "$me" "$dir" "$to" "$(grep -c '' "$to")" >&2
    return
  fi
  fold_ "$dir" "$where"
}
fold_() {
  dir=$1; where=${2-}
  [ -f "$dir/n" ] && cat "$dir/n"
  [ -f "$dir/t" ] && cat "$dir/t"
  wc=""; wv=""
  if [ -n "$where" ]; then wc=${where%%=*}; wv=${where#*=}; [ -n "$(colnum "$dir" "$wc")" ] || die "fold: --where names no column: $wc"; fi
  while IFS= read -r k; do
    ke=$(kenc "$k"); rd="$dir/r/$ke"; line=""; first=1
    if [ -n "$wc" ]; then v=$(cell "$rd/$(encl "$wc")"); [ "$v" = "$wv" ] || continue; fi
    while IFS= read -r c; do
      v=$(cell "$rd/$(encl "$c")")
      if [ $first -eq 1 ]; then line=$v; first=0; else line="$line$TAB$v"; fi
    done < "$dir/l"
    printf '%s\n' "$line"
  done < "$dir/a"
  [ -f "$dir/o" ] && cat "$dir/o"
  return 0
}

# ---------------------------------------------------------------- set / get / who / col
set_() {
  dir=${1:?DIR}; k=${2:?KEY}; c=${3:?COL}; v=${4-}
  need_stem "$dir"
  [ -n "$(colnum "$dir" "$c")" ] || die "set: $c is not a column of $dir (tv1cr col $dir $c adds one)"
  case $c$v in *"$TAB"*) die "set: a tab in a column or value" ;; esac
  nparts=$(printf '%s\n' "$k" | awk -F"$TAB" '{ print NF }'); [ "$nparts" -eq "$(grep -c '' "$dir/i")" ] \
    || die "set: the key has $nparts part(s); $dir/i names $(grep -c '' "$dir/i") (join parts with a tab)"
  ke=$(kenc "$k"); ce=$(encl "$c"); ve=$(encl "$v")
  rd="$dir/r/$ke"; f="$rd/$ce"
  st=$(stamp)     # the time this hand writes: the name of d/<stamp>/ below and the line in sc/ and sr/ (one time, so they agree)
  mkdir -p "$dir/sc" "$dir/sr"
  if [ ! -d "$rd" ]; then
    mkdir -p "$rd"; printf '%s\n' "$k" >> "$dir/a"
    rest=$k
    while IFS= read -r kc; do   # each key part lands in its own column, both sides
      case $rest in *"$TAB"*) part=${rest%%"$TAB"*}; rest=${rest#*"$TAB"} ;; *) part=$rest; rest="" ;; esac
      kce=$(encl "$kc"); pe=$(encl "$part")
      printf '%s\n' "$part" > "$rd/$kce"; mkdir -p "$dir/c/$kce"; printf '%s\n' "$k" >> "$dir/c/$kce/$pe"
      printf '%s\n' "$st" > "$dir/sc/$kce"     # a new row writes its key column too
    done < "$dir/i"
  fi
  if [ -f "$f" ]; then
    old=$(cell "$f"); oe=$(encl "$old")
    mkdir -p "$dir/d/$st/r/$ke"; cp -p "$f" "$dir/d/$st/r/$ke/$ce"
    m="$dir/c/$ce/$oe"
    if [ -f "$m" ]; then
      K="$k" awk 'BEGIN { k = ENVIRON["K"] } $0 != k' "$m" > "$m.tmp"
      mv "$m.tmp" "$m"     # an empty member file lists nobody (the mount cannot rm; it can truncate)
    fi
  fi
  if [ -z "$v" ]; then : > "$f"; else printf '%s\n' "$v" > "$f"; fi
  mkdir -p "$dir/c/$ce"; printf '%s\n' "$k" >> "$dir/c/$ce/$ve"
  printf '%s\n' "$st" > "$dir/sc/$ce"      # sc: when this column was last written
  printf '%s\n' "$st" > "$dir/sr/$ke"      # sr: when this row was
  printf '%s: set %s %s = %s (r/%s/%s, c/%s/%s)\n' "$me" "$k" "$c" "$v" "$ke" "$ce" "$ce" "$ve" >&2
}
get_() {
  dir=${1:?DIR}; k=${2:?KEY}; c=${3-}
  need_stem "$dir"; ke=$(kenc "$k"); rd="$dir/r/$ke"
  [ -d "$rd" ] || die "get: no key $k in $dir" 1
  if [ -n "$c" ]; then cell "$rd/$(encl "$c")"; printf '\n'; return; fi
  while IFS= read -r col; do printf '%s\t%s\n' "$col" "$(cell "$rd/$(encl "$col")")"; done < "$dir/l"
}
who() {
  dir=${1:?DIR}; c=${2:?COL}; v=${3-}
  need_stem "$dir"; m="$dir/c/$(encl "$c")/$(encl "$v")"
  [ -f "$m" ] && cat "$m" || exit 1
}
col() {
  dir=${1:?DIR}; c=${2:?NAME}; need_stem "$dir"
  [ -z "$(colnum "$dir" "$c")" ] || die "col: $c is already a column"
  case $c in *"$TAB"*) die "col: a tab in a column name" ;; esac
  printf '%s\n' "$c" >> "$dir/l"; mkdir -p "$dir/c/$(encl "$c")"
  if [ -f "$dir/t" ]; then printf '%s\t%s\n' "$(cat "$dir/t")" "$c" > "$dir/t.tmp"; mv "$dir/t.tmp" "$dir/t"; fi
  printf '%s: column %s added to %s\n' "$me" "$c" "$dir" >&2
}

# ---------------------------------------------------------------- route (Q609, built 2026-10-20)
relpath() {  # relpath FROM TO -> TO relative to FROM (both made absolute; python-free: awk over the parts)
  f=$(cd "$1" && pwd); t=$(cd "$2" && pwd)
  awk -v f="$f" -v t="$t" 'BEGIN {
    nf = split(f, F, "/"); nt = split(t, T, "/"); i = 1
    while (i <= nf && i <= nt && F[i] == T[i]) i++
    out = ""; for (j = i; j <= nf; j++) if (F[j] != "") out = out "../"
    for (j = i; j <= nt; j++) if (T[j] != "") out = out T[j] "/"
    sub(/\/$/, "", out); if (out == "") out = "."; print out }'
}
route() {
  chk=0; [ "${1-}" = --check ] && { chk=1; shift; }
  dir=${1:?DIR}; col=${2:?COL}; shift 2; root=""; name=""
  while [ $# -gt 0 ]; do case $1 in --into) root=$2; shift 2 ;; --as) name=$2; shift 2 ;; *) die "route: unknown option $1" ;; esac; done
  need_stem "$dir"; [ -n "$root" ] || die "route: say --into ROOT; the root is asserted, never searched"
  [ -d "$root" ] || die "route: no such root: $root"
  [ -n "$(colnum "$dir" "$col")" ] || die "route: $col is not a column of $dir"
  [ -n "$name" ] || name=$col
  ce=$(encl "$col"); ne=$(encl "$name"); rel=$(relpath "$root" "$dir"); faults=0; added=0
  [ $chk -eq 1 ] || mkdir -p "$root/c/$ne"
  while IFS= read -r k; do
    ke=$(kenc "$k"); f="$dir/r/$ke/$ce"; v=$(cell "$f"); ve=$(encl "$v"); addr="$rel/r/$ke"; m="$root/c/$ne/$ve"
    if [ $chk -eq 1 ]; then
      if [ ! -f "$m" ] || ! A="$addr" awk 'BEGIN { a = ENVIRON["A"]; f = 1 } $0 == a { f = 0 } END { exit f }' "$m"; then
        echo "FAULT $addr ($col = '$v') is not routed in c/$ne/$ve"; faults=$((faults+1)); fi
      continue
    fi
    if [ -f "$m" ] && A="$addr" awk 'BEGIN { a = ENVIRON["A"]; f = 1 } $0 == a { f = 0 } END { exit f }' "$m"; then :; else
      printf '%s\n' "$addr" >> "$m"; added=$((added+1)); fi
  done < "$dir/a"
  if [ $chk -eq 1 ]; then
    # the other direction: every routed line under c/<name>/ that points into this table reads back
    for m in "$root/c/$ne"/*; do
      [ -f "$m" ] || continue; ve=$(basename "$m")
      while IFS= read -r addr; do
        case $addr in "$rel/r/"*) ;; *) continue ;; esac
        f="$root/$addr/$ce"
        if [ ! -f "$f" ]; then echo "FAULT c/$ne/$ve routes $addr but it has no $col atom"; faults=$((faults+1)); continue; fi
        got=$(encl "$(cell "$f")"); [ "$got" = "$ve" ] || { echo "FAULT c/$ne/$ve routes $addr whose $col encodes to $got"; faults=$((faults+1)); }
      done < "$m"
    done
    if [ $faults -eq 0 ]; then echo "route --check: holds ($col of $dir in $root/c/$ne)"; else echo "route --check: $faults fault(s)"; exit 1; fi
    return
  fi
  printf '%s: routed %s of %s into %s/c/%s (%s line(s) added, %s key(s))\n' "$me" "$col" "$dir" "$root" "$ne" "$added" "$(grep -c '' "$dir/a")" >&2
}

# ---------------------------------------------------------------- check
# check_stamps_each DIR: the stamp half of check, one shell step per name (the second reader of the awk half in check below).
# Prints the same lines; sfaults is the number of FAULT lines.  A stem with neither sc/ nor sr/ has nothing to check.
check_stamps_each() {
  sfaults=0; nsc=0; nsr=0; nstale=0; newest=""; np=""
  [ -d "$1/sc" ] || [ -d "$1/sr" ] || return 0
  sv0=$(first_line "$1/s"); s_ok=0; if is_stamp "$sv0"; then s_ok=1; fi
  w2=$(mktemp -d "${TMPDIR:-/tmp}/tv1cr-stamps.XXXXXX")
  while IFS= read -r c2; do encl "$c2"; done < "$1/l" > "$w2/cols"
  while IFS= read -r k2; do kenc "$k2"; done < "$1/a" > "$w2/keys"
  for kind in sc sr; do
    for f2 in "$1/$kind"/*; do
      [ -f "$f2" ] || continue; n2=${f2##*/}
      if [ $kind = sc ]; then
        grep -qxF -- "$n2" "$w2/cols" || { echo "FAULT sc/$n2 names no column of l"; sfaults=$((sfaults+1)); continue; }
      else
        grep -qxF -- "$n2" "$w2/keys" || { echo "FAULT sr/$n2 names no key of a"; sfaults=$((sfaults+1)); continue; }
      fi
      v2=$(first_line "$f2")
      is_stamp "$v2" || { echo "FAULT $kind/$n2 holds [$v2], not a stamp"; sfaults=$((sfaults+1)); continue; }
      if [ $kind = sc ]; then nsc=$((nsc+1)); else nsr=$((nsr+1)); fi
      if [ $s_ok -eq 1 ] && newer "$v2" "$sv0"; then
        nstale=$((nstale+1))
        if [ -z "$newest" ] || newer "$v2" "$newest" || { [ "$v2" = "$newest" ] && newer "$np" "$kind/$n2"; }; then newest=$v2; np="$kind/$n2"; fi
      fi
    done
  done
  rm -rf "$w2"
  if [ $nstale -gt 0 ]; then echo "stale: $nstale stamp(s) newer than s ($sv0); the newest is $np ($newest)"
  elif [ $s_ok -eq 0 ]; then echo "stale: s holds no stamp, so the stamps were not compared with it"
  else echo "stamps: $nsc sc, $nsr sr; none newer than s"; fi
}

# check_each: the first check, one shell step per atom (2m57s for 11,406 atoms on the mount); kept as
# check --each, a second reader of the one-pass check below, which the spec compares it with
check_each() {
  dir=${1:?DIR}; need_stem "$dir"; faults=0
  # every key in a has a dir; every dir is in a
  while IFS= read -r k; do ke=$(kenc "$k"); [ -d "$dir/r/$ke" ] || { echo "FAULT key in a without r/: $k (r/$ke)"; faults=$((faults+1)); }; done < "$dir/a"
  for rd in "$dir"/r/*/; do
    [ -d "$rd" ] || continue; ke=$(basename "$rd")
    # r -> c: each atom's value is listed in its collection under the encoded name
    for f in "$rd"*; do
      [ -f "$f" ] || continue; ce=$(basename "$f"); v=$(cell "$f"); ve=$(encl "$v")
      m="$dir/c/$ce/$ve"
      if [ ! -f "$m" ]; then echo "FAULT r/$ke/$ce = '$v' has no c/$ce/$ve"; faults=$((faults+1)); continue; fi
      k=$(keycell "$dir" "$rd")
      K="$k" awk 'BEGIN { k = ENVIRON["K"]; f = 1 } $0 == k { f = 0 } END { exit f }' "$m" \
        || { echo "FAULT r/$ke/$ce = '$v' but c/$ce/$ve does not list key '$k'"; faults=$((faults+1)); }
    done
  done
  # c -> r: each line of each member file reads back to the same encoded name (case collisions
  # on a folding disk show up here: the directory's name differs from the value's encoding)
  for cd in "$dir"/c/*/; do
    [ -d "$cd" ] || continue; ce=$(basename "$cd")
    for m in "$cd"*; do
      [ -f "$m" ] || continue; ve=$(basename "$m")
      while IFS= read -r k; do
        [ -n "$k" ] || continue
        ke=$(kenc "$k"); f="$dir/r/$ke/$ce"
        if [ ! -f "$f" ]; then echo "FAULT c/$ce/$ve lists '$k' but r/$ke/$ce is absent"; faults=$((faults+1)); continue; fi
        got=$(encl "$(cell "$f")")
        [ "$got" = "$ve" ] || { echo "FAULT c/$ce/$ve lists '$k' whose r/$ke/$ce encodes to $got"; faults=$((faults+1)); }
      done < "$m"
    done
  done
  check_stamps_each "$dir"; faults=$((faults+sfaults))
  if [ $faults -eq 0 ]; then echo "check: holds ($(grep -c '' "$dir/a") key(s), $(grep -c '' "$dir/l") column(s); r and c agree)"; else echo "check: $faults fault(s)"; exit 1; fi
}

# check: the same three questions in one awk pass over every atom (fold-up ENHANCE 1, 2026-10-20):
# every key in a has a dir; each r atom is listed in its collection under its value's name; each
# collection line reads back to an r atom whose value encodes to that name. Same FAULT lines.
check() {
  dir=${1:?DIR}; [ "${2:-}" = --each ] && { check_each "$dir"; return; }
  need_stem "$dir"
  w=$(mktemp -d "${TMPDIR:-/tmp}/tv1cr-check.XXXXXX")
  ( cd "$dir" && { find r -type f; find c -type f; for sx in sc sr; do [ -d "$sx" ] && find "$sx" -type f; done; true; } ) > "$w/files" 2>/dev/null || true
  set +e
  D="$dir" T="$w/v" awk -v TAB="$TAB" -v RULE="$RULE" -v SRE="$(stamp_re)" "$AJ1"'
    function enc(s,   n, out, up, i, ch) {
      n = length(s); out = ""; up = 0
      for (i = 1; i <= n; i++) {
        ch = substr(s, i, 1)
        if (ch ~ /[A-Z]/) { if (!up) { out = out "^"; up = 1 }; out = out tolower(ch); continue }
        if (up) { out = out "^"; up = 0 }
        if (ch ~ /[a-z0-9._-]/) out = out ch
        else out = out sprintf("%%%02X", ord[ch])
      }
      if (up) out = out "^"
      if (out == "." || out == "..") gsub(/\./, "%2E", out)
      if (out ~ /\.$/) out = substr(out, 1, length(out) - 1) "%2E"   # Windows drops a trailing dot (2026-10-23)
      if (out ~ /^(con|prn|aux|nul|com[0-9]|lpt[0-9])(\.|$)/) out = sprintf("%%%02X", ord[substr(out, 1, 1)]) substr(out, 2)   # a Windows device name (2026-10-23)
      if (out == "") out = "%"
      return out
    }
    function encl(s,   e, h, c) {
      e = (RULE == "aj1") ? aj1(s) : enc(s); if (length(e) <= 200) return e
      printf "%s", s > ENVIRON["T"]; close(ENVIRON["T"])
      c = "sha256sum < \"" ENVIRON["T"] "\""; c | getline h; close(c)
      return (RULE == "aj1") ? aj1cut(e, 180) "jh" substr(h, 1, 16) : substr(e, 1, 180) "%~" substr(h, 1, 16)
    }
    function kenc(k,   n, p, i, o) { n = split(k, p, TAB); o = ""; for (i = 1; i <= n; i++) o = o (i > 1 ? (RULE == "aj1" ? "jk" : "+") : "") encl(p[i]); return o }
    function cell(f,   l, v, n) { v = ""; n = 0; while ((getline l < f) > 0) { v = (n++ ? v "\n" : "") l } close(f); return v }
    function first(f,   l) { l = ""; (getline l < f); close(f); return l }
    BEGIN {
      for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
      d = ENVIRON["D"]; faults = 0
      ni = 0; while ((getline l < (d "/i")) > 0) icol[++ni] = encl(l); close(d "/i")
      nl = 0; while ((getline l < (d "/l")) > 0) { nl++; colenc[encl(l)] = 1 } close(d "/l")
      while ((getline f < ARGV[1]) > 0) {
        if (f ~ /^r\//) { rest = substr(f, 3); j = index(rest, "/"); if (!j) continue
          ke = substr(rest, 1, j - 1); ce = substr(rest, j + 1); if (ce ~ /\//) continue
          val[ke, ce] = cell(d "/" f); has[ke, ce] = 1; rdir[ke] = 1; ratom[++nr] = ke SUBSEP ce }
        else if (f ~ /^c\//) { rest = substr(f, 3); j = index(rest, "/"); if (!j) continue
          ce = substr(rest, 1, j - 1); ve = substr(rest, j + 1); if (ve ~ /\//) continue
          cfile[ce, ve] = 1; nc++; cname[nc] = ce; vname[nc] = ve
          m = 0; while ((getline k < (d "/" f)) > 0) { mem[ce, ve, k] = 1; lines[nc, ++m] = k } close(d "/" f); cl[nc] = m }
        else if (f ~ /^s[cr]\//) { rest = substr(f, 4); if (rest ~ /\//) continue      # sc/<enc col> and sr/<enc key>: the stamps
          ns++; sk[ns] = substr(f, 1, 2); sn[ns] = rest; sv[ns] = first(d "/" f) }
      }
      close(ARGV[1])
      nk = 0; while ((getline k < (d "/a")) > 0) { nk++; ke = kenc(k); keyenc[ke] = 1; if (!(ke in rdir)) { print "FAULT key in a without r/: " k " (r/" ke ")"; faults++ } } close(d "/a")
      for (x = 1; x <= nr; x++) {
        split(ratom[x], pr, SUBSEP); ke = pr[1]; ce = pr[2]; v = val[ke, ce]; ve = encl(v)
        if (!((ce, ve) in cfile)) { print "FAULT r/" ke "/" ce " = \047" v "\047 has no c/" ce "/" ve; faults++; continue }
        k = ""; for (q = 1; q <= ni; q++) k = k (q > 1 ? TAB : "") val[ke, icol[q]]
        if (!((ce, ve, k) in mem)) { print "FAULT r/" ke "/" ce " = \047" v "\047 but c/" ce "/" ve " does not list key \047" k "\047"; faults++ }
      }
      for (x = 1; x <= nc; x++) for (y = 1; y <= cl[x]; y++) {
        k = lines[x, y]; if (k == "") continue; ce = cname[x]; ve = vname[x]; ke = kenc(k)
        if (!((ke, ce) in has)) { print "FAULT c/" ce "/" ve " lists \047" k "\047 but r/" ke "/" ce " is absent"; faults++; continue }
        got = encl(val[ke, ce]); if (got != ve) { print "FAULT c/" ce "/" ve " lists \047" k "\047 whose r/" ke "/" ce " encodes to " got; faults++ }
      }
      # the stamp half: each sc/ names a column of l, each sr/ a key of a, each holds a stamp; a stamp newer than s is said, not a fault
      s0 = first(d "/s"); s_ok = (s0 ~ SRE)
      for (x = 1; x <= ns; x++) {
        p = sk[x] "/" sn[x]
        if (sk[x] == "sc" && !(sn[x] in colenc)) { print "FAULT " p " names no column of l"; faults++; continue }
        if (sk[x] == "sr" && !(sn[x] in keyenc)) { print "FAULT " p " names no key of a"; faults++; continue }
        if (sv[x] !~ SRE) { print "FAULT " p " holds [" sv[x] "], not a stamp"; faults++; continue }
        if (sk[x] == "sc") nsc++; else nsr++
        if (s_ok && sv[x] > s0) { nstale++; if (nstale == 1 || sv[x] > newest || (sv[x] == newest && p < np)) { newest = sv[x]; np = p } }
      }
      if (ns > 0) {
        if (nstale) print "stale: " nstale " stamp(s) newer than s (" s0 "); the newest is " np " (" newest ")"
        else if (!s_ok) print "stale: s holds no stamp, so the stamps were not compared with it"
        else print "stamps: " nsc " sc, " nsr " sr; none newer than s"
      }
      if (faults == 0) printf "check: holds (%d key(s), %d column(s); r and c agree)\n", nk, nl
      else printf "check: %d fault(s)\n", faults
      exit(faults ? 1 : 0)
    }' "$w/files"
  rc=$?; set -e; rm -rf "$w"; [ $rc -eq 0 ] || exit 1
}

# ---------------------------------------------------------------- stale / stamp
# stale DIR [TSV] [--col COL] [--key KEY]
#   no flag: exit 1 when any atom is newer than the TSV (or than s, when s is later), or when any sc/ or sr/ stamp is newer than s
#   --col / --key: ask about one column's or one row's stamp only, against s: 1 newer (said), 0 not newer, 2 no stamp / no s (said)
stale() {
  dir=${1:?DIR}; shift; tsv=""; scol=""; skey=""; asked=0
  while [ $# -gt 0 ]; do
    case $1 in
      --col) [ $# -ge 2 ] || die "stale: --col wants a column"; scol=$2; asked=1; shift 2 ;;
      --key) [ $# -ge 2 ] || die "stale: --key wants a key"; skey=$2; asked=1; shift 2 ;;
      -*) die "stale: unknown option $1" ;;
      *) tsv=$1; shift ;;
    esac
  done
  need_stem "$dir"
  sv0=$(first_line "$dir/s")
  if [ $asked -eq 1 ]; then
    hot=0; unknown=0
    if [ -n "$scol" ]; then
      [ -n "$(colnum "$dir" "$scol")" ] || die "stale: $scol is not a column of $dir"
      stale_one "column $scol" "sc/$(encl "$scol")" || { rc=$?; if [ $rc -eq 1 ]; then hot=1; else unknown=1; fi; }
    fi
    if [ -n "$skey" ]; then
      [ -d "$dir/r/$(kenc "$skey")" ] || die "stale: no key $skey in $dir"
      stale_one "key $skey" "sr/$(kenc "$skey")" || { rc=$?; if [ $rc -eq 1 ]; then hot=1; else unknown=1; fi; }
    fi
    if [ $hot -eq 1 ]; then exit 1; fi
    if [ $unknown -eq 1 ]; then exit 2; fi
    return 0
  fi
  tsv=${tsv:-$dir.tsv}
  [ -f "$tsv" ] || { echo "stale: no folded table at $tsv"; exit 2; }
  mark=$tsv; [ -f "$dir/s" ] && [ "$dir/s" -nt "$tsv" ] && mark="$dir/s"
  newest=$(find "$dir/r" "$dir/c" "$dir/a" "$dir/l" "$dir/i" -newer "$mark" 2>/dev/null | head -1)
  hot=0
  if [ -n "$newest" ]; then echo "stale: $tsv is older than $newest"; hot=1; fi
  # the stamps: every sc/ and sr/ line against s (a stamp is the writer's own word for when it wrote)
  if is_stamp "$sv0"; then
    sline=$(for f in "$dir"/sc/* "$dir"/sr/*; do
              [ -f "$f" ] || continue
              v=$(first_line "$f"); printf '%s\t%s\n' "${f#"$dir"/}" "$v"
            done | awk -F"$TAB" -v s0="$sv0" '$2 > s0 { n++; if (n == 1 || $2 > nv || ($2 == nv && $1 < np)) { nv = $2; np = $1 } } END { if (n) print n "\t" np "\t" nv }')
    if [ -n "$sline" ]; then
      echo "stale: $(printf '%s' "$sline" | cut -f1) stamp(s) newer than s ($sv0); the newest is $(printf '%s' "$sline" | cut -f2) ($(printf '%s' "$sline" | cut -f3))"; hot=1
    fi
  fi
  if [ $hot -eq 1 ]; then exit 1; fi
  echo "fresh: no atom under $dir is newer than $tsv, and no stamp is newer than s"
}
# stale_one WHAT RELPATH -> says it; returns 0 not newer than s, 1 newer, 2 cannot tell (no stamp, or s holds none)
stale_one() {
  so_f="$dir/$2"
  [ -f "$so_f" ] || { echo "stale: no stamp for $1 ($2 is absent; an old stem: sh $0 stamp $dir writes them from the mtimes)"; return 2; }
  so_v=$(first_line "$so_f")
  is_stamp "$so_v" || { echo "stale: $2 holds [$so_v], not a stamp"; return 2; }
  is_stamp "$sv0" || { echo "stale: s holds no stamp to compare $2 with"; return 2; }
  if newer "$so_v" "$sv0"; then echo "stale: $1 was written at $so_v, after s ($sv0): $2"; return 1; fi
  echo "fresh: $1 was written at $so_v, not after s ($sv0)"; return 0
}

# stamp DIR: write the sc/ and sr/ a stem made before they existed lacks, from the files' mtimes: a column's stamp is the newest
# mtime among its cells (r/*/<col>), a row's the newest among its cells.  The file system's time, not the writer's; a stamp already
# there is the writer's own and is kept.  GNU find (-printf).  awk converts the epoch (no process per name).
stamp_cmd() {
  dir=${1:?DIR}; need_stem "$dir"
  w=$(mktemp -d "${TMPDIR:-/tmp}/tv1cr-stamp.XXXXXX"); trap 'rm -rf "$w"' EXIT
  while IFS= read -r c2; do encl "$c2"; done < "$dir/l" > "$w/cols"
  while IFS= read -r k2; do kenc "$k2"; done < "$dir/a" > "$w/keys"
  ( cd "$dir" && find r -type f -printf '%T@\t%p\n' ) > "$w/mt" 2>/dev/null || true
  mkdir -p "$dir/sc" "$dir/sr"
  D="$dir" W="$w" RULE="$RULE" awk -F"$TAB" '
    function two(n) { return sprintf("%02d", n) }
    function ymd(t,   z, era, doe, yoe, y, doy, mp, d, m, sec, hh, mi, ss) {
      sec = t % 86400; z = (t - sec) / 86400 + 719468
      era = int(z / 146097); doe = z - era * 146097
      yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
      y = yoe + era * 400; doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
      mp = int((5 * doy + 2) / 153); d = doy - int((153 * mp + 2) / 5) + 1; m = mp < 10 ? mp + 3 : mp - 9
      if (m <= 2) y++
      hh = int(sec / 3600); mi = int((sec - hh * 3600) / 60); ss = sec - hh * 3600 - mi * 60
      return (ENVIRON["RULE"] == "aj1") ? sprintf("%04d%s%st%s%s%sz", y, two(m), two(d), two(hh), two(mi), two(ss)) : sprintf("%04d-%s-%sT%s%s%sZ", y, two(m), two(d), two(hh), two(mi), two(ss)) }
    BEGIN { d = ENVIRON["D"]; w = ENVIRON["W"]
      while ((getline c < (w "/cols")) > 0) wantc[c] = 1
      while ((getline k < (w "/keys")) > 0) wantk[k] = 1 }
    { t = int($1); p = $2; if (p !~ /^r\/[^\/]+\/[^\/]+$/) next
      split(p, q, "/"); ke = q[2]; ce = q[3]
      if (t > mc[ce]) mc[ce] = t
      if (t > mr[ke]) mr[ke] = t }
    END {
      for (ce in mc) if (ce in wantc) put(d "/sc/" ce, ymd(mc[ce]))
      for (ke in mr) if (ke in wantk) put(d "/sr/" ke, ymd(mr[ke]))
      printf "%d %d %d %d\n", wrote["sc"], kept["sc"], wrote["sr"], kept["sr"] > "/dev/stderr" }
    function put(f, v,   x) { if ((getline x < f) >= 0) { close(f); kept[substr(f, length(d) + 2, 2)]++; return }
      print v > f; close(f); wrote[substr(f, length(d) + 2, 2)]++ }' "$w/mt" 2> "$w/n" || true
  read -r wc_ kc_ wr_ kr_ < "$w/n" || true
  printf '%s: stamped %s from the files'"'"' mtimes (the file system'"'"'s time, not the writer'"'"'s): %s sc and %s sr written, %s and %s kept as they were\n' "$me" "$dir" "${wc_:-0}" "${wr_:-0}" "${kc_:-0}" "${kr_:-0}" >&2
}

# ---------------------------------------------------------------- selftest / prove-red
# stamps_agree DIR KEY COL: sc/<col> and sr/<key> are one stamp each, equal to each other and to the newest d/ folder's name
# (what set must have written; the selftest asks it after a set, and --prove-red shows it going red when set left one out)
stamps_agree() {
  need_stem "$1"; sa_c=$(first_line "$1/sc/$(encl "$3")"); sa_r=$(first_line "$1/sr/$(kenc "$2")"); sa_d=$(ls "$1/d" | tail -1)
  [ -n "$sa_c" ] && [ "$sa_c" = "$sa_r" ] && [ "$sa_c" = "$sa_d" ]
}
selftest() {
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
  printf '# a note\nid\tstate\tsense\nq1\tOPEN\tfirst, with a space\nq2\t\tSeam/seam %%\n' > "$t/x.tsv"
  # aj1 first (the default for a new stem): round trip, check, and every name 0-9a-z only
  cp "$t/x.tsv" "$t/z.tsv"; TV1CR_NEW_RULE= "$0" unfold "$t/z.tsv" 2>/dev/null
  [ "$(cat "$t/z/e")" = aj1 ] || die "selftest: a new stem was not given aj1"
  "$0" fold "$t/z" | cmp -s - "$t/z.tsv" || die "selftest: aj1 fold != unfold input"
  "$0" check "$t/z" >/dev/null || die "selftest: check failed on a fresh aj1 unfold"
  [ "$(ls "$t/z/sc" | wc -l)" -eq 3 ] && [ "$(ls "$t/z/sr" | wc -l)" -eq 2 ] || die "selftest: unfold did not write one sc/ per column and one sr/ per key"
  [ "$(cat "$t/z/sc"/* "$t/z/sr"/* | sort -u)" = "$(cat "$t/z/s")" ] || die "selftest: an unfold stamp is not the stamp of s"
  [ -z "$(cd "$t/z" && find r c -name '*[!0-9a-z]*' | head -1)" ] || die "selftest: an aj1 name outside 0-9a-z"
  "$0" unfold "$t/x.tsv" --rule pc1 2>/dev/null
  "$0" fold "$t/x" > "$t/y.tsv"; cmp -s "$t/x.tsv" "$t/y.tsv" || die "selftest: fold != unfold input"
  "$0" check "$t/x" >/dev/null || die "selftest: check failed on a fresh unfold"
  [ "$("$0" who "$t/x" state '')" = q2 ] || die "selftest: who on the empty value"
  "$0" set "$t/x" q2 state RULED 2>/dev/null; "$0" check "$t/x" >/dev/null || die "selftest: check after set"
  [ "$("$0" get "$t/x" q2 state)" = RULED ] || die "selftest: get after set"
  [ -f "$t/x/d"/*/r/q2/state ] || die "selftest: set kept nothing under d/"
  "$0" stale "$t/x" "$t/x.tsv" >/dev/null && die "selftest: stale said fresh after set"
  # the stamps: set wrote the stamp it used for d/ into sc/<col> and sr/<key>; fold does not read them; an old stem has none and holds
  ( stamps_agree "$t/x" q2 state ) || die "selftest: set did not write the stamp it used for d/ into sc/state and sr/q2"
  "$0" fold "$t/x" > "$t/with.tsv"; cp -R "$t/x" "$t/old"; rm -rf "$t/old/sc" "$t/old/sr"
  "$0" fold "$t/old" | cmp -s - "$t/with.tsv" || die "selftest: fold read the stamps (its bytes changed without sc/ and sr/)"
  "$0" check "$t/old" >/dev/null || die "selftest: check failed on a stem with no sc/ and sr/ (an old stem is not a fault)"
  rc=0; "$0" stale "$t/old" --col state >/dev/null 2>&1 || rc=$?; [ $rc -eq 2 ] || die "selftest: stale --col on a stem with no stamps did not say it cannot tell (exit 2, not $rc)"
  "$0" stamp "$t/old" 2>/dev/null; [ -f "$t/old/sc/state" ] && [ -f "$t/old/sr/q2" ] || die "selftest: stamp did not fill the stamps of an old stem"
  "$0" check "$t/old" >/dev/null || die "selftest: check failed after stamp"
  printf '2099-12-31T235959Z\n' > "$t/x/s"; "$0" stale "$t/x" --col state >/dev/null || die "selftest: stale --col red though no stamp is newer than s"
  printf '2000-01-01T000000Z\n' > "$t/x/s"; "$0" stale "$t/x" --col state >/dev/null && die "selftest: stale --col green though the stamp is newer than s"
  "$0" stale "$t/x" --key q2 >/dev/null && die "selftest: stale --key green though the stamp is newer than s"
  printf '2026-10-27T000000Z\n' > "$t/x/sc/ghost"; "$0" check "$t/x" 2>&1 | grep -q 'sc/ghost' || die "selftest: check did not name a stray sc/ghost"
  "$0" check "$t/x" >/dev/null 2>&1 && die "selftest: check held with a stamp for a column that is not in l"
  "$0" check "$t/x" --each 2>&1 | grep -q 'sc/ghost' || die "selftest: check --each did not name a stray sc/ghost"
  rm -f "$t/x/sc/ghost"; "$0" check "$t/x" >/dev/null || die "selftest: check failed after the stray stamp was removed"
  if [ "${1:-}" = --prove-red ]; then
    printf 'q3\n' >> "$t/x/c/state/^open^"      # a one-sided write: c says, r does not
    "$0" check "$t/x" >/dev/null 2>&1 && die "PROVE-RED: check missed a one-sided c write"
    printf 'OPEN\n' > "$t/x/r/q1/state.swap"; mv "$t/x/r/q1/state.swap" "$t/x/r/q1/state"
    printf 'RULED\n' > "$t/x/r/q1/state"       # r changed, c not told
    "$0" check "$t/x" >/dev/null 2>&1 && die "PROVE-RED: check missed a one-sided r write"
    # the stamp half: a set that left out sc/, a set that left out sr/, a stamp for a column that is not in l, a stamp newer than s
    # that stale --col must call red, and a stamp older than s that it must not.  Each is planted in the stem; the reader must see it.
    sc_=$(first_line "$t/x/sc/state"); sr_=$(first_line "$t/x/sr/q2")
    rm -f "$t/x/sc/state"; ( stamps_agree "$t/x" q2 state ) && die "PROVE-RED: stamps_agree missed a set that wrote no sc/"
    printf '%s\n' "$sc_" > "$t/x/sc/state"; ( stamps_agree "$t/x" q2 state ) || die "PROVE-RED: stamps_agree red with both stamps back"
    rm -f "$t/x/sr/q2"; ( stamps_agree "$t/x" q2 state ) && die "PROVE-RED: stamps_agree missed a set that wrote no sr/"
    printf '%s\n' "$sr_" > "$t/x/sr/q2"
    printf '2026-10-27T000000Z\n' > "$t/x/sc/ghost"
    "$0" check "$t/x" >/dev/null 2>&1 && die "PROVE-RED: check missed a stamp for a column that is not in l"
    rm -f "$t/x/sc/ghost"
    printf '2000-01-01T000000Z\n' > "$t/x/s"; printf '2026-10-27T000000Z\n' > "$t/x/sc/sense"
    "$0" stale "$t/x" --col sense >/dev/null 2>&1 && die "PROVE-RED: stale --col missed a stamp newer than s"
    printf '2099-12-31T235959Z\n' > "$t/x/s"
    "$0" stale "$t/x" --col sense >/dev/null 2>&1 || die "PROVE-RED: stale --col called a stamp older than s red"
    echo "PROVE-RED OK (7 planted faults, all caught)"
  fi
  echo "selftest OK (round trip, check, who, set, get, d/, stale, stamps)"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
  unfold) unfold "$@" ;;
  fold) fold "$@" ;;
  set) set_ "$@" ;;
  get) get_ "$@" ;;
  who) who "$@" ;;
  col) col "$@" ;;
  route) route "$@" ;;
  check) check "$@" ;;
  stale) stale "$@" ;;
  stamp) stamp_cmd "$@" ;;
  enc) if [ "${2-}" = --rule ]; then RULE=${3-}; case $RULE in pc1|aj1) ;; az1) die "enc: --rule az1: $AZ1_GONE; say aj1" ;; *) die "enc: no rule named '$RULE' (pc1, aj1)" ;; esac; fi
       encl "${1-}" ;;
  dec) [ "${2-}" = --rule ] && [ "${3-}" != aj1 ] && die "dec: only aj1 names are read back (pc1 has no dec)"
       N="${1-}" awk "$AJ1"'BEGIN { v = aj1dec(ENVIRON["N"]); if (AJERR != "") { print "tv1cr: dec: " AJERR > "/dev/stderr"; exit 1 } print v }' ;;
  selftest) selftest ;;
  --prove-red) selftest --prove-red ;;
  -h|--help|'') usage ;;
  *) usage >&2; die "unknown command: $cmd" ;;
esac
